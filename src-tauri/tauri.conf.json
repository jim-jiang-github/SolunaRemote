{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SolunaRemote",
  "version": "0.4.0",
  "identifier": "local.solunaremote.desktop",
  "build": {
    "frontendDist": "../app/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SolunaRemote",
        "width": 867,
        "height": 600,
        "minWidth": 867,
        "minHeight": 600,
        "decorations": false,
        "backgroundColor": "#f6f8fc"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": ["resources/**/*"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
