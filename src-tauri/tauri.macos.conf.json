{
  "bundle": {
    "targets": ["dmg"],
    "icon": ["icons/icon.icns"],
    "resources": [
      "resources/native/**/*",
      "resources/host/Sunshine.app.zip",
      "resources/host/Sunshine.app.zip.json",
      "resources/host/release.json",
      "resources/host/THIRD-PARTY-NOTICES.txt",
      "resources/host/licenses/**/*"
    ]
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SolunaRemote",
        "width": 867,
        "height": 600,
        "minWidth": 867,
        "minHeight": 600,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "shadow": false,
        "backgroundColor": "#f6f8fc"
      }
    ]
  }
}
